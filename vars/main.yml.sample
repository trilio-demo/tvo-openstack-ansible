---
# vars/main.yml.sample — template for per-cluster vars/main.yml
# Copy to vars/main.yml and fill in cluster-specific values. The real
# vars/main.yml is gitignored.
#
# Most values come from the cluster's openrc (see vars/openrc/<cluster>.sh
# alongside this file). Password lives in vars/vault.yml as
# vault_os_password.

# ── OpenStack auth ────────────────────────────────────────────────────────────
# These flow through each play's `environment:` block as OS_* env vars.
# The playbooks consume _NAME forms of the domain vars; if your cluster's
# openrc only supplies _ID, resolve once with:
#   openstack --insecure domain show <id> -f value -c name
os_auth_url: "<https://keystone-host:5000/v3>"
os_username: "<username>"
os_project_id: "<project-uuid>"
os_project_name: "<project-name>"
os_user_domain_name: "<user-domain-name>"
os_project_domain_name: "<project-domain-name>"
os_region_name: "<RegionOne-or-regionOne>"    # case-sensitive — copy verbatim
os_interface: "public"

# ── Resource naming ───────────────────────────────────────────────────────────
# demo_prefix: prepended to all managed resources. Empty = bare names.
demo_prefix: ""
demo_keypair: "vincent-ansible-key"
demo_sg: "vbsg-ssh"

# ── Tenant networks (cluster-specific) ────────────────────────────────────────
# Discover with:
#   openstack --insecure network list --project $OS_PROJECT_ID
# External (FIP) network is auto-discovered. No edit needed.
prod_network: "<prod-network-name>"
data_network: "<data-network-name>"

# ── Trilio workload definitions ───────────────────────────────────────────────
# backup_target_type is the NAME (or UUID) of an entry from:
#   openstack --insecure workloadmgr backup target type list
# (NOT `backup target list` — that's the storage endpoint; the type is a
# named binding to it. The --backup-target-type CLI flag consumes the type.)
# Run `playbooks/discover.yml` to enumerate everything for a new cluster.
#
# demo_tag is used by --tags to run a single demo:
#   ansible-playbook playbooks/setup_trilio.yml --tags fw

trilio_workloads:
  - name: firewall-workload
    description: "Virtual firewall appliance — One-Click Restore demo"
    demo_tag: fw
    instance_names:
      - firewall-vm
    backup_target_type: "<S3-target-type-name-or-uuid>"
    snapshot_name: firewall-snapshot

  - name: webapp-workload
    description: "3-tier web application — Selective and In-Place Restore demos"
    demo_tag: app
    instance_names:
      - webapp-lb
      - webapp-fe
      - webapp-be
    backup_target_type: "<NFS-target-type-name-or-uuid>"
    snapshot_name: webapp-snapshot

  - name: database-workload
    description: "Primary/replica database — crash-consistent DB backup demo"
    demo_tag: pg
    instance_names:
      - database-primary
      - database-replica
    backup_target_type: "<S3-target-type-name-or-uuid>"
    snapshot_name: database-snapshot
